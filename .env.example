# Playground token from Simplismart Settings -> API Key
SIMPLISMART_PG_TOKEN=replace-me

# Required by organization-scoped lifecycle operations such as restart
ORG_ID=replace-with-org-uuid

# Optional: lets restart avoid a repeated --namespace flag
SIMPLISMART_NAMESPACE=replace-with-kubernetes-namespace

# Required for vLLM engine authentication and benchmark clients.
BENCHMARK_API_KEY=replace-me

# Required for Hugging Face model downloads.
HF_TOKEN=replace-me
