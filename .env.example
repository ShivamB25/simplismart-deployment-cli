# Simplismart control-plane credential from Settings -> API Key.
SIMPLISMART_PG_TOKEN=replace-me

# Required for organization-scoped lifecycle operations and manifest deployment.
ORG_ID=replace-with-org-uuid

# Optional: avoids a repeated --namespace flag for restart.
SIMPLISMART_NAMESPACE=replace-with-kubernetes-namespace

# Optional overrides; defaults are used when omitted.
# SIMPLISMART_BASE_URL=https://api.app.simplismart.ai
# SIMPLISMART_TIMEOUT=300

# Required by the checked-in BYOC manifests for model API authentication and
# Hugging Face model downloads. Use one HF variable only.
BENCHMARK_API_KEY=replace-me
HF_TOKEN=replace-me
